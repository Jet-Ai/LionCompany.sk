# Cloudflare Workers Build variables — set these in the Cloudflare dashboard
# (Workers Builds > your project > Settings > Build variables), never commit real values.

# Required. UUID of the D1 database used to store contact-form inquiries.
# Deploy fails on purpose if this is missing (see scripts/cloudflare-deploy.mjs).
D1_DATABASE_ID=

# Optional. Name of the D1 database. Defaults to "lion-company-inquiries" if unset.
D1_DATABASE_NAME=lion-company-inquiries

# Optional. Name of the deployed Worker. Defaults to "lioncompany-sk" if unset.
CLOUDFLARE_WORKER_NAME=lioncompany-sk
